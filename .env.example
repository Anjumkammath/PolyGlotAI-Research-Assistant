APP_NAME=PolyGlotAI Research Assistant
APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

UPLOAD_DIR=storage/uploads
EXTRACTED_TEXT_DIR=storage/extracted
CHUNK_DIR=storage/extracted/chunks
DOCUMENT_INDEX_PATH=storage/documents.json
LANGUAGE_CONFIG_PATH=config/languages.json
EMBEDDING_CONFIG_PATH=config/embedding_models.json
TRANSLATION_METHODS_CONFIG_PATH=config/translation_methods.json
TRANSLATION_LANGUAGE_CODES_PATH=config/translation_language_codes.json
VECTOR_DB_DIR=storage/vector_db
MEMORY_DB_PATH=storage/memory.sqlite3
MAX_PDF_SIZE_MB=25

VECTOR_DB_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_DOCUMENT_COLLECTION=documents
QDRANT_MEMORY_COLLECTION=memory
QDRANT_VECTOR_SIZE=384

EMBEDDING_MODEL=multilingual-minilm
CHUNK_SIZE=900
CHUNK_OVERLAP=180
MAX_CONTEXT_CHUNKS=5

# Options: fallback, openai, ollama
LLM_PROVIDER=fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

DEFAULT_ANSWER_LANGUAGE=en
DEFAULT_TRANSLATION_METHOD=google
NLLB_MODEL_NAME=facebook/nllb-200-distilled-600M
