# PolyGlotAI production deployment template.
# Copy this file to .env.production and edit the public URLs/secrets before deploy.

APP_NAME=PolyGlotAI Research Assistant
APP_ENV=production

# Use exact deployed frontend origins. Avoid "*" for a public app.
# Examples:
# BACKEND_CORS_ORIGINS=https://polyglotai.example.com,https://www.polyglotai.example.com
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173

# Used by docker-compose.prod.yml when building the React app.
# For a VPS demo, set this to http://YOUR_SERVER_IP:8000 or https://api.your-domain.com.
PUBLIC_API_BASE_URL=http://localhost:8000

# Host ports exposed by docker-compose.prod.yml.
BACKEND_PORT=8000
REACT_PORT=80
STREAMLIT_PORT=8501

UPLOAD_DIR=storage/uploads
EXTRACTED_TEXT_DIR=storage/extracted
CHUNK_DIR=storage/extracted/chunks
DOCUMENT_INDEX_PATH=storage/documents.json
LANGUAGE_CONFIG_PATH=config/languages.json
LANGUAGE_QUALITY_CONFIG_PATH=config/language_quality_evaluation.json
EMBEDDING_CONFIG_PATH=config/embedding_models.json
TRANSLATION_METHODS_CONFIG_PATH=config/translation_methods.json
TRANSLATION_LANGUAGE_CODES_PATH=config/translation_language_codes.json
VECTOR_DB_DIR=storage/vector_db
MEMORY_DB_PATH=storage/memory.sqlite3
MAX_PDF_SIZE_MB=25

VECTOR_DB_PROVIDER=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Use model-specific names so switching embeddings does not collide with old vectors.
QDRANT_DOCUMENT_COLLECTION=documents_minilm_384
QDRANT_MEMORY_COLLECTION=memory_minilm_384
QDRANT_VECTOR_SIZE=384

EMBEDDING_MODEL=multilingual-minilm
CHUNK_SIZE=900
CHUNK_OVERLAP=180
MAX_CONTEXT_CHUNKS=5

# Options: fallback, openai, ollama
# For a public demo, OpenAI gives better answers, but fallback is safer without keys.
LLM_PROVIDER=fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

DEFAULT_ANSWER_LANGUAGE=en
DEFAULT_TRANSLATION_METHOD=google
NLLB_MODEL_NAME=facebook/nllb-200-distilled-600M
